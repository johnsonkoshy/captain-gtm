# Copy to .env.local. Every key is optional: a missing key puts that adapter on seed data.
# Keys are read only in server code (lib/env.ts, route handlers). Never prefix with NEXT_PUBLIC_.

# LLM (Claude): drafts the ICP and outreach
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Tavily: search with source links
TAVILY_API_KEY=

# Hunter.io: work-email verification
HUNTER_API_KEY=

# Neo4j AuraDB: the knowledge graph
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Flexprice: metering and the credit wallet (live path is a stub until wired from official docs)
FLEXPRICE_API_KEY=
FLEXPRICE_CUSTOMER_ID=

# Band: the agent room (live path is a stub until wired from official docs)
BAND_API_KEY=
BAND_ROOM_ID=

# Outbox. Approved sends go ONLY to these teammate addresses, never to prospects.
# Empty = dry run: approvals are recorded, nothing is delivered.
SEND_ALLOWLIST=teammate-one@yourteam.example,teammate-two@yourteam.example
# Optional delivery through Resend; without it the outbox is in-memory.
RESEND_API_KEY=
MAIL_FROM=
